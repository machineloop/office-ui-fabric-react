{
  "name": "react-swatch-picker",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/react-components/react-swatch-picker/library/src",
  "tags": ["platform:web", "vNext"],
  "implicitDependencies": [],
  "targets": {
    "e2e-swatchpicker": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "dependsOn": [{ "target": "build", "projects": "scripts-cypress" }],
      "options": {
        "cwd": "packages/react-components/react-swatch-picker/library",
        "command": "yarn run -T cypress run --component --config-file src/components/SwatchPicker/cypress.config.cjs"
      },
      "metadata": {
        "description": "Run the complete component-local SwatchPicker functional suite with its existing Cypress configuration."
      }
    }
  }
}
