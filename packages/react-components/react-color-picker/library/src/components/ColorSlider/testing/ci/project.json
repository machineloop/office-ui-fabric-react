{
  "name": "colorslider-functional-tests",
  "$schema": "../../../../../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["vNext", "platform:web", "test"],
  "implicitDependencies": ["react-color-picker"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node src/components/ColorSlider/ColorSlider.run.cjs standard",
        "cwd": "packages/react-components/react-color-picker/library"
      },
      "inputs": [
        "{workspaceRoot}/packages/react-components/react-color-picker/library/src/components/ColorSlider/**/*",
        "{workspaceRoot}/packages/react-components/react-color-picker/library/cypress.config.ts",
        "{workspaceRoot}/scripts/cypress/**/*"
      ],
      "cache": false
    },
    "type-check": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "target": "build", "projects": "scripts-cypress" }],
      "options": {
        "command": "node node_modules/typescript/bin/tsc -p packages/react-components/react-color-picker/library/src/components/ColorSlider/testing/tsconfig.json --pretty false",
        "cwd": "."
      },
      "inputs": [
        "{workspaceRoot}/packages/react-components/react-color-picker/library/src/components/ColorSlider/**/*"
      ],
      "cache": false
    }
  }
}
