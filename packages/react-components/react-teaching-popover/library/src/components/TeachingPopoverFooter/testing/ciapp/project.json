{
  "name": "teachingpopoverfooter-functional-tests",
  "$schema": "../../../../../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["vNext", "platform:web", "test"],
  "implicitDependencies": ["react-teaching-popover", "react-components", "react-teaching-popover-stories"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "target": "build", "projects": "scripts-cypress" }],
      "options": {
        "command": "node src/components/TeachingPopoverFooter/TeachingPopoverFooter.run.cjs standard",
        "cwd": "packages/react-components/react-teaching-popover/library"
      },
      "inputs": [
        "{workspaceRoot}/packages/react-components/react-teaching-popover/library/src/components/TeachingPopoverFooter/**/*",
        "{workspaceRoot}/packages/react-components/react-teaching-popover/library/cypress.config.ts",
        "{workspaceRoot}/scripts/cypress/**/*"
      ],
      "cache": false
    },
    "type-check": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "target": "build", "projects": "scripts-cypress" }],
      "options": {
        "command": "node node_modules/typescript/bin/tsc -p packages/react-components/react-teaching-popover/library/src/components/TeachingPopoverFooter/testing/tsconfig.json --pretty false",
        "cwd": "."
      },
      "inputs": [
        "{workspaceRoot}/packages/react-components/react-teaching-popover/library/src/components/TeachingPopoverFooter/**/*"
      ],
      "cache": false
    }
  }
}
